{
  "name": "vite-plugin-memory-leak-detector",
  "version": "1.0.0",
  "description": "A Vite plugin to detect potential memory leaks in frontend code at build time.",
  "author": "You",
  "license": "MIT",
  "homepage": "https://github.com/unknownman/vite-plugin-memory-leak-detector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unknownman/vite-plugin-memory-leak-detector.git"
  },
  "bugs": {
    "url": "https://github.com/unknownman/vite-plugin-memory-leak-detector/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.1.0",
    "estree-walker": "^3.0.3",
    "oxc-parser": "^0.30.0",
    "picocolors": "^1.0.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/estree": "^1.0.0",
    "@types/node": "^20.0.0",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "memory-leak",
    "static-analysis",
    "performance",
    "ast",
    "oxc",
    "react",
    "vue",
    "svelte",
    "solid"
  ]
}
