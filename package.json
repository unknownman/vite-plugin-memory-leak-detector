{
  "name": "vite-plugin-memory-leak-detector",
  "version": "1.0.0",
  "description": "A Vite plugin to detect potential memory leaks in frontend code at build time.",
  "author": "You",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.1.0",
    "estree-walker": "^3.0.3",
    "oxc-parser": "^0.30.0",
    "picocolors": "^1.0.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@types/estree": "^1.0.0",
    "@types/node": "^20.0.0",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "memory-leak",
    "static-analysis",
    "performance",
    "ast",
    "oxc"
  ]
}
